    map = mask(xi+0.5*wi, yi+0.5*hi, 0.1*wi, value, map, xi, yi, wi, hi)
    map = mask(xi+0.5*wi,        yi, 0.1*wi, value, map, xi, yi, wi, hi)
    map = mask    (xi+wi,     yi+hi, 0.1*wi, value, map, xi, yi, wi, hi)

    print(map.dtype)

    plot(ax, map, xi, yi, wi, hi)

    ipoint(ax,     0,     0, map, xi, yi, wi, hi, 'o', 'green')
    ipoint(ax, 0.5*W,     0, map, xi, yi, wi, hi, 'o', 'blue')
    ipoint(ax,     W,     0, map, xi, yi, wi, hi, 'o', 'cyan')
    ipoint(ax, 0.5*W, 0.5*H, map, xi, yi, wi, hi, 'o', 'yellow')
    ipoint(ax,     0,     H, map, xi, yi, wi, hi, 'o', 'magenta')
    ipoint(ax,     0, 0.5*H, map, xi, yi, wi, hi, 'o', 'red')
